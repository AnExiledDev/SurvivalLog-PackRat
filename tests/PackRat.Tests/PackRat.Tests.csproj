<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
    <!-- Exiled's Toolkit's source folder, the one its built DLL sits two folders under (bin\Release). -->
    <ToolkitSrc>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(ToolkitDll)'))))))</ToolkitSrc>
  </PropertyGroup>

  <!-- The pure core is compiled straight in, with the Toolkit's plain helper it uses, so the tests need none of the game or BepInEx assemblies. -->
  <ItemGroup>
    <Compile Include="..\..\src\PackRat\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="$(ToolkitSrc)\Core\JsText.cs" Link="Toolkit\JsText.cs" />
  </ItemGroup>

  <!-- The page scripts and their data, as the plugin ships them, run in Jint against a fake page, with the Toolkit's page API. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\PackRat\Page\tab.js" LogicalName="PackRat.tab.js" Link="Page\tab.js" />
    <EmbeddedResource Include="..\..\src\PackRat\Page\bags.js" LogicalName="PackRat.bags.js" Link="Page\bags.js" />
    <EmbeddedResource Include="..\..\src\PackRat\Page\data.js" LogicalName="PackRat.data.js" Link="Page\data.js" />
    <EmbeddedResource Include="$(ToolkitSrc)\api.js" LogicalName="ExiledToolkit.api.js" Link="Toolkit\api.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
